{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "agent-ui-dev",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "LOCAL_STUDIO_HOME=build/agent-ui-state",
        "LOCAL_STUDIO_SEARCH_PORT=8093",
        "uv",
        "run",
        "-q",
        "--no-project",
        "--python",
        "3.12",
        "--with-requirements",
        "requirements-app.txt",
        "uvicorn",
        "app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "7861"
      ],
      "port": 7861
    },
    {
      "name": "agent-ui-fake",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "LOCAL_STUDIO_HOME=build/agent-ui-state",
        "LOCAL_STUDIO_SEARCH_PORT=8093",
        "uv",
        "run",
        "-q",
        "--no-project",
        "--python",
        "3.12",
        "--with-requirements",
        "requirements-app.txt",
        "uvicorn",
        "fake_dev:app",
        "--app-dir",
        "build/agent-ui-state",
        "--host",
        "127.0.0.1",
        "--port",
        "7861"
      ],
      "port": 7861
    }
  ]
}
