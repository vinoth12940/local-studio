  },
  "outcome": [
    {
      "type": "command",
      "argv": [
        "python3",
        "check_config.py"
      ],
      "expect_exit": 0
    },
    {
      "type": "file_contains",
      "path": "settings.json",
      "text": "\"port\": 8080"
    },
    {
      "type": "file_unchanged",
      "path": "check_config.py"
    }
  ]
